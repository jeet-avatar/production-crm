# TCP v6 video pipeline — required env vars
# Copy to .env (which is .gitignored) and fill in real values.

# ElevenLabs API key (voice + music generation)
# Voice id locked: cjVigY5qzO86Huf0OWal
ELEVENLABS_API_KEY=sk_REPLACE_ME
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal

# Anthropic API (web search for prospect research)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# AWS — for S3 uploads (videos + GIFs + landing pages)
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1

# S3 buckets (already provisioned)
S3_VIDEO_BUCKET=brandmonkz-video-campaigns
S3_LANDING_BUCKET=watch.techcloudpro.com

# Cloudflare zone for watch.techcloudpro.com — already configured, no action needed
# (DNS: CNAME watch → S3 website endpoint, SSL = Flexible)

# Optional — Resend, for sending. The CRM backend already has this; the
# pipeline doesn't need to send directly. Adding here in case batch-ship
# is ever extended to fire emails.
# RESEND_API_KEY=re_REPLACE_ME
